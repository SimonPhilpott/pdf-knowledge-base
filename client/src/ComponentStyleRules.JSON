{
  "designSystem": {
    "name": "Google Antigravity Premium",
    "theme": "Oatmeal / Dark",
    "coreColors": {
      "ivory": "#F1EFE9",
      "sageGreen": "#899981",
      "charcoal": "#2E2B27",
      "indigo": "#6366F1"
    }
  },
  "components": {
    "BinaryToggle": {
      "wrapperClass": "mode-switcher",
      "itemClass": "mode-item",
      "description": "Used for balanced 50/50 toggles in the sidebar (Library/Gemini, Theme, Citations).",
      "styles": {
        "display": "flex",
        "flex": "1",
        "gap": "1px",
        "padding": "4px",
        "borderRadius": "var(--radius-full)",
        "itemWidth": "100%",
        "itemFlex": "1"
      }
    },
    "ResizableSidebar": {
      "resizerClass": "sidebar-resizer",
      "description": "Standard draggable handle for resizing lateral panels.",
      "styles": {
        "width": "8px",
        "hitArea": "8px",
        "zIndex": "5000",
        "activeColor": "var(--accent-indigo)"
      }
    }
  }
}